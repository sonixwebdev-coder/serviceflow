# ServiceFlow environment template
# Copy to .env for local development. Blank values are optional or must be
# generated for the target deployment. Never commit real credentials.

# Runtime
NODE_ENV=development
PORT=5000
DB_POOL_SIZE=20
DB_POOL_TIMEOUT=30
PRISMA_TX_MAX_WAIT=5000
PRISMA_TX_TIMEOUT=10000
SLOW_QUERY_THRESHOLD=1000
FILE_STORAGE_ROOT=apps/backend/storage
PDF_FONT_REGULAR_PATH=
PDF_FONT_BOLD_PATH=

# Data services. POSTGRES_PASSWORD is intentionally blank and must be set before
# starting docker-compose.prod.yml. DATABASE_URL matches the disposable local
# services in docker-compose.yml.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=serviceflow
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/serviceflow
REDIS_URL=redis://localhost:6379

# Authentication and encryption (generate unique values for every deployment)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_SECRET=
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL_DAYS=30
CSRF_SECRET=
ENCRYPTION_KEY=
GOOGLE_ENCRYPTION_KEY=
HASH_SALT_ROUNDS=12

# Platform identity. ServiceFlow is the default; distributions may override it.
PLATFORM_NAME=ServiceFlow
PLATFORM_URL=http://localhost:5173
PLATFORM_CONTACT_EMAIL=contact@example.com

# Application URLs
FRONTEND_URL=http://localhost:5173
CLIENT_PORTAL_URL=http://localhost:5174
PORTAL_URL=http://localhost:5174
WEBSITE_BASE_URL=http://localhost:5175
# Optional alternative for subdomain deployments, for example https://{subdomain}.example.com
WEBSITE_URL_TEMPLATE=
API_BASE_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# Frontend build-time fallbacks. Runtime configuration will take precedence.
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
VITE_WS_URL=http://localhost:5000
VITE_CLIENT_PORTAL_URL=http://localhost:5174
VITE_FRONTEND_URL=http://localhost:5173
VITE_WEBSITE_BASE_URL=http://localhost:5175
VITE_PLATFORM_NAME=ServiceFlow
VITE_PLATFORM_URL=http://localhost:5173
VITE_PLATFORM_CONTACT_EMAIL=contact@example.com
VITE_SENTRY_DSN=

# Static application runtime configuration (used by Docker images)
SERVICEFLOW_API_URL=http://localhost:5000/api
SERVICEFLOW_SOCKET_URL=http://localhost:5000
SERVICEFLOW_APP_URL=http://localhost:5173
SERVICEFLOW_PORTAL_URL=http://localhost:5174
SERVICEFLOW_WEBSITE_URL=http://localhost:5175
SERVICEFLOW_ADMIN_URL=http://localhost:5176

# Optional container smoke-test targets (comma-separated name=url pairs)
STATIC_APP_URLS=

# Email: configure either Brevo or SMTP
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@example.com
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=ServiceFlow
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# Web push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/google/callback

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Observability
SENTRY_DSN=

# Company defaults used by PDF and email output
COMPANY_NAME=Example Company
COMPANY_LEGAL_NAME=Example Company SRL
COMPANY_TAX_ID=
COMPANY_VAT_NUMBER=
COMPANY_REGISTRATION=
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=contact@example.com
COMPANY_WEBSITE=http://localhost:5175
COMPANY_CONTACT_PERSON=
COMPANY_BANK_NAME=
COMPANY_IBAN=
COMPANY_SWIFT=
COMPANY_LOGO_URL=
COMPANY_ADDITIONAL_NOTE=
COMPANY_FOOTER_NOTE=
COMPANY_GDPR_NOTE=
