{
  "name": "@serviceflow/backend",
  "version": "1.0.0",
  "private": true,
  "description": "ServiceFlow backend API",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "./dev-start.sh",
    "dev:no-redis": "nodemon server.js",
    "prisma:generate": "prisma generate --schema ../../prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema ../../prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema ../../prisma/schema.prisma",
    "lint": "eslint . --max-warnings 0",
    "pretest": "npm run prisma:generate",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand --testPathIgnorePatterns=/__tests__/e2e/",
    "pretest:integration": "npm run prisma:generate",
    "test:integration": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand __tests__/e2e"
  },
  "keywords": [
    "employee-management",
    "team-management",
    "serviceflow",
    "crm"
  ],
  "author": "ServiceFlow contributors",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "archiver": "^8.0.0",
    "axios": "1.20.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csrf-csrf": "^4.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.4",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "express-rate-limit": "^8.7.0",
    "googleapis": "^182.0.0",
    "handlebars": "^4.7.8",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "nodemailer": "10.0.10",
    "otplib": "^13.5.0",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^6.0.1",
    "socket.io": "4.8.4",
    "stripe": "^22.6.2",
    "web-push": "^3.6.7",
    "xml2js": "^0.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "adm-zip": "0.6.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "prisma": "7.9.0",
    "supertest": "^7.1.4"
  }
}
