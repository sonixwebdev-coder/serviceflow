{
  "name": "@serviceflow/backend",
  "version": "1.0.0",
  "private": true,
  "description": "ServiceFlow backend API",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "./dev-start.sh",
    "dev:no-redis": "nodemon server.js",
    "prisma:generate": "prisma generate --schema ../../prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema ../../prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema ../../prisma/schema.prisma",
    "lint": "eslint . --max-warnings 0",
    "test": "jest --runInBand --testPathIgnorePatterns=/__tests__/e2e/",
    "test:integration": "jest --runInBand __tests__/e2e"
  },
  "keywords": [
    "employee-management",
    "team-management",
    "serviceflow",
    "crm"
  ],
  "author": "ServiceFlow contributors",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@getbrevo/brevo": "^6.0.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "7.9.0",
    "archiver": "^8.0.0",
    "axios": "1.18.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csrf-csrf": "^4.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "express-rate-limit": "^8.6.0",
    "googleapis": "^173.0.0",
    "handlebars": "^4.7.8",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "node-cron": "^4.6.0",
    "nodemailer": "9.0.3",
    "otplib": "^13.4.1",
    "papaparse": "^5.5.4",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^6.0.0",
    "socket.io": "4.8.3",
    "stripe": "^22.3.2",
    "web-push": "^3.6.7",
    "xml2js": "^0.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "adm-zip": "0.6.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prisma": "6.19.3",
    "supertest": "^7.1.4"
  }
}
