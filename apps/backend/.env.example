# ServiceFlow Backend — Local Environment Overrides
# The backend loads the ROOT .env (../../.env) first, then this file.
# Only add variables here if you need to OVERRIDE the root values for local dev.
# For production, configure everything in the root .env file.
#
# See ../../.env.example for the full list of variables.

# Uncomment to override for local development:
# NODE_ENV=development
# PORT=5000
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/serviceflow"
# REDIS_URL=redis://localhost:6379
# FRONTEND_URL=http://localhost:5173
# CLIENT_PORTAL_URL=http://localhost:5174
# WEBSITE_BASE_URL=http://localhost:5175
# API_BASE_URL=http://localhost:5000
# GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/google/callback
