PORT=5000
NODE_ENV=development

# PostgreSQL connection string used by Prisma
# For production with 1000+ users, set connection_limit=20 and pool_timeout=30:
# DATABASE_URL="postgresql://user:pass@host:5432/db?connection_limit=20&pool_timeout=30"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/forjait"

# Optional direct connection string for Prisma (e.g. pgbouncer)
# DATABASE_DIRECT_URL="postgresql://postgres:postgres@localhost:5432/forjait"

# Temporary MongoDB connection (legacy modules)
MONGODB_URI=mongodb://127.0.0.1:27017/forjait

# JWT secrets (update with secure random strings in production)
JWT_ACCESS_SECRET=replace-with-access-secret
JWT_REFRESH_SECRET=replace-with-refresh-secret
# Temporary compatibility until legacy auth is migrated off MongoDB
JWT_SECRET=replace-with-legacy-secret

# CSRF Protection (generate with: openssl rand -base64 32)
CSRF_SECRET=replace-with-csrf-secret

# Encryption for sensitive data like ANAF OAuth secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=replace-with-encryption-key

# Password hashing
HASH_SALT_ROUNDS=12

# Redis (optional - for caching, improves performance)
# If not configured, the application will run without caching
# REDIS_URL=redis://localhost:6379

# Email / SMTP (optional - configure when enabling outbound email)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=username
SMTP_PASSWORD=password
SMTP_FROM="ForjaIt CRM <no-reply@forja.it.com>"

# ANAF E-Factura Integration (Romanian Tax Authority)
# Production endpoints
ANAF_AUTHORIZATION_URL=https://logincert.anaf.ro/anaf-oauth2/v1/authorize
ANAF_TOKEN_URL=https://logincert.anaf.ro/anaf-oauth2/v1/token
ANAF_API_BASE_URL=https://webserviceapl.anaf.ro/prod/FCTEL/rest

# Test endpoints (used when NODE_ENV=development)
ANAF_TEST_API_BASE_URL=https://webserviceapl.anaf.ro/test/FCTEL/rest

# OAuth2 redirect URI (must match the one registered with ANAF)
ANAF_REDIRECT_URI=https://your-domain.com/api/anaf/auth/callback

# Slow query logging (queries above this threshold are logged to logs/slow-queries.log)
SLOW_QUERY_THRESHOLD=500

# Background jobs configuration
ANAF_ENABLE_AUTO_SUBMIT=false
ANAF_ENABLE_STATUS_SYNC=true
ANAF_ENABLE_TOKEN_REFRESH=true
ANAF_ENABLE_MESSAGE_DOWNLOAD=true
ANAF_ENABLE_RETRY_FAILED=true

# Application URLs
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000

# Google Calendar Integration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match Google Cloud Console authorized redirect URI
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/google/callback

# Push Notifications (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your-public-key
VAPID_PRIVATE_KEY=your-private-key
VAPID_SUBJECT=mailto:admin@forja.it.com

# Stripe Billing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# For dev with `stripe listen --forward-to`, paste the whsec_ from CLI output here.
# In production, the webhook secret is read from PlatformSettings in DB.
STRIPE_WEBHOOK_SECRET=whsec_...
