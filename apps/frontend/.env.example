# ServiceFlow Frontend (CRM Dashboard) — Build-time variables
# These are baked into the JS bundle by Vite at build time.
# In Docker, these are passed as ARG (see Dockerfile).

VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
# VITE_SENTRY_DSN=https://your-sentry-dsn

# Cross-app URLs (used for links between apps)
VITE_CLIENT_PORTAL_URL=http://localhost:5174
VITE_WEBSITE_BASE_URL=http://localhost:5175
