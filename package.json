{
  "name": "serviceflow",
  "private": true,
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "apps/frontend",
    "apps/backend",
    "apps/client-portal",
    "apps/admin",
    "apps/website",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "packageManager": "npm@11.18.0",
  "scripts": {
    "dev": "node scripts/start-all.js",
    "dev:frontend": "npm run dev --workspace apps/frontend",
    "dev:backend": "npm run dev --workspace apps/backend",
    "dev:portal": "npm run dev --workspace apps/client-portal",
    "dev:admin": "npm run dev --workspace apps/admin",
    "dev:website": "npm run dev --workspace apps/website",
    "build": "npm run build --workspaces --if-present",
    "build:frontend": "npm run build --workspace apps/frontend",
    "build:portal": "npm run build --workspace apps/client-portal",
    "build:admin": "npm run build --workspace apps/admin",
    "build:website": "npm run build --workspace apps/website",
    "lint": "eslint apps packages scripts prisma --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:tooling": "node --test scripts/*.test.js",
    "test": "npm run test:tooling && npm run test --workspaces --if-present",
    "test:integration": "node scripts/run-integration-tests.js",
    "static:smoke": "node scripts/static-app-smoke.js",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "env:check": "node scripts/check-env-example.js",
    "docs:check": "node scripts/check-doc-links.js",
    "openapi:sync": "node scripts/sync-openapi-routes.js",
    "openapi:validate": "node scripts/validate-openapi.js",
    "modules:check": "node scripts/check-module-size.js",
    "bundle:check": "node scripts/check-bundle-size.js",
    "audit": "npm audit --audit-level=moderate",
    "release:sbom": "node scripts/generate-release-inventory.js --sbom-only",
    "release:licenses": "node scripts/generate-release-inventory.js --licenses-only",
    "release:inventory": "node scripts/generate-release-inventory.js",
    "check": "npm run env:check && npm run docs:check && npm run openapi:validate && npm run modules:check && npm run format:check && npm run lint && npm run prisma:validate && npm run test && npm run build && npm run bundle:check",
    "install:all": "npm install --workspaces --include-workspace-root",
    "db:seed": "node prisma/seed.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prisma/client": "7.9.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "prisma": "7.9.1"
  },
  "overrides": {
    "exceljs": {
      "unzipper": "0.12.5",
      "uuid": "11.1.1"
    }
  },
  "allowScripts": {
    "@prisma/client@7.9.0": true,
    "@prisma/engines@7.9.0": true,
    "esbuild@0.28.1": true,
    "prisma@7.9.0": true,
    "unrs-resolver@1.12.2": true
  }
}
