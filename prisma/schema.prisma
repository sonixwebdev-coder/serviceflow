model LoyaltyProgram {
  id                   String            @id @default(cuid())
  organizationId       String            @unique
  isEnabled            Boolean           @default(false)
  pointsPerRon         Decimal           @default(1) @db.Decimal(10, 2)
  bronzeThreshold      Int               @default(100)
  silverThreshold      Int               @default(500)
  goldThreshold        Int               @default(1000)
  platinumThreshold    Int               @default(5000)
  bronzeDiscount       Decimal           @default(0) @db.Decimal(5, 2)
  silverDiscount       Decimal           @default(5) @db.Decimal(5, 2)
  goldDiscount         Decimal           @default(10) @db.Decimal(5, 2)
  platinumDiscount     Decimal           @default(15) @db.Decimal(5, 2)
  visitRewardEnabled   Boolean           @default(false)
  visitRewardEveryN    Int               @default(10)
  visitRewardType      LoyaltyRewardType @default(BONUS_POINTS)
  visitRewardValue     Decimal           @default(50) @db.Decimal(10, 2)
  referralEnabled      Boolean           @default(false)
  referralBonusPoints  Int               @default(100)
  referralNewClientPts Int               @default(50)
  pointsExpiryDays     Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  organization         Organization      @relation(fields: [organizationId], references: [id])
  accounts             LoyaltyAccount[]

  @@index([organizationId])
}

model LoyaltyAccount {
  id              String              @id @default(cuid())
  clientId        String              @unique
  programId       String
  currentPoints   Int                 @default(0)
  lifetimePoints  Int                 @default(0)
  currentTier     LoyaltyTier         @default(BRONZE)
  completedVisits Int                 @default(0)
  referralCode    String              @unique
  referredById    String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  client          Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  program         LoyaltyProgram      @relation(fields: [programId], references: [id])
  referredBy      LoyaltyAccount?     @relation("LoyaltyReferrals", fields: [referredById], references: [id])
  referrals       LoyaltyAccount[]    @relation("LoyaltyReferrals")
  transactions    LoyaltyTransaction[]

  @@index([clientId])
  @@index([programId])
  @@index([referralCode])
  @@index([currentTier])
}

model LoyaltyTransaction {
  id               String                 @id @default(cuid())
  accountId        String
  type             LoyaltyTransactionType
  points           Int
  balanceAfter     Int
  description      String?
  paymentId        String?
  appointmentId    String?
  invoiceId        String?
  referredClientId String?
  createdAt        DateTime               @default(now())
  account          LoyaltyAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([type])
  @@index([paymentId])
}

