model WebsiteLead {
  id              String           @id @default(cuid())
  websiteId       String
  firstName       String
  lastName        String
  email           String
  phone           String?
  message         String?
  source          String?
  status          LeadStatus       @default(NEW)
  clientId        String?
  isApproved      Boolean?
  createdAt       DateTime         @default(now())

  website         Website          @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@index([websiteId, source, isApproved])
}

