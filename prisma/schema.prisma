generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  status               OrganizationStatus    @default(TRIAL)
  plan                 SubscriptionPlan      @default(FREE)
  trialEndsAt          DateTime?
  trialStartedAt       DateTime              @default(now())
  stripeCustomerId     String?               @unique
  subscriptionId       String?               @unique
  subscriptionEndsAt   DateTime?
  trialUsed            Boolean               @default(false) @map("trial_used")
  subscriptionStartedAt DateTime?            @map("subscription_started_at")
  billingInterval      String?               @map("billing_interval")
  planOverride         Boolean               @default(false)
  planOverrideBy       String?
  planOverrideAt       DateTime?
  planOverrideReason   String?
  settings             Json?
  activitySector       ActivitySector        @default(AUTOMOTIVE)
  maxUsers             Int                   @default(5)
  maxClients           Int                   @default(100)
  maxAppointments      Int                   @default(500)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  appointments         Appointment[]
  assets               Asset[]
  auditLogs            AuditLog[]
  clients              Client[]
  invoices             Invoice[]
  locations            Location[]
  notifications        Notification[]
  payments             Payment[]
  registrationRequests RegistrationRequest[]
  resources            Resource[]
  schedules            Schedule[]
  serviceOrders        ServiceOrder[]
  tasks                Task[]
  timeEntries          TimeEntry[]
  timeOffRequests      TimeOffRequest[]
  users                User[]
  chatChannels         ChatChannel[]
  emailLogs            EmailLog[]
  emailTemplates       EmailTemplate[]
  website              Website?
  loyaltyProgram       LoyaltyProgram?
  supportTickets       SupportTicket[]
  quotaAddons          QuotaAddon[]
  profile              OrganizationProfile?

  @@index([slug])
  @@index([status])
}

model QuotaAddon {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  type            String    // CLIENTS_100, CLIENTS_300, APPOINTMENTS_200, APPOINTMENTS_500
  resource        String    // 'clients' or 'appointments'
  amount          Int       // 100, 300, 200, 500
  purchasedAt     DateTime  @default(now()) @map("purchased_at")
  expiresAt       DateTime? @map("expires_at") // null = permanent (clients), end-of-month (appointments)
  stripePaymentId String?   @map("stripe_payment_id")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, resource])
  @@map("quota_addons")
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  password               String
  firstName              String
  lastName               String
  phoneNumber            String?
  dateOfBirth            DateTime?
  employmentType         EmploymentType          @default(FULL_TIME)
  hourlyRate             Decimal?                @db.Decimal(10, 2)
  hireDate               DateTime?               @default(now())
  isActive               Boolean                 @default(true)
  isSuperAdmin           Boolean                 @default(false)
  avatarUrl              String?
  resetToken             String?
  resetTokenExpiry       DateTime?
  leaveBalanceVacation   Int                     @default(21)
  leaveBalanceSick       Int                     @default(15)
  leaveBalancePersonal   Int                     @default(5)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  lastLoginAt            DateTime?
  failedLoginAttempts    Int                     @default(0)
  lockedUntil            DateTime?
  twoFactorSecret        String?
  twoFactorEnabled       Boolean                 @default(false)
  twoFactorBackupCodes   Json?
  twoFactorLastUsedAt    DateTime?
  twoFactorFailedAttempts Int                    @default(0)
  organizationId         String?
  appointmentsCreated    Appointment[]           @relation("AppointmentCreatedBy")
  appointmentsUpdated    Appointment[]           @relation("AppointmentUpdatedBy")
  appointmentAssignees   AppointmentAssignee[]
  auditLogs              AuditLog[]
  locations              UserLocation[]
  messages               Message[]
  messageReadReceipts    MessageReadReceipt[]
  notifications          Notification[]          @relation("NotificationRecipient")
  paymentsCreated        Payment[]
  personalTodos          PersonalTodo[]
  refreshTokens          RefreshToken[]
  registrationReviews    RegistrationRequest[]   @relation("RegistrationReviewer")
  schedulesCreated       Schedule[]              @relation("ScheduleCreatedBy")
  schedules              Schedule[]              @relation("ScheduleEmployee")
  schedulesUpdated       Schedule[]              @relation("ScheduleUpdatedBy")
  tasksCreated           Task[]                  @relation("TaskCreatedBy")
  tasksUpdated           Task[]                  @relation("TaskUpdatedBy")
  taskAssignments        TaskAssignment[]
  taskComments           TaskComment[]
  timeEntries            TimeEntry[]
  timeOffRequests        TimeOffRequest[]        @relation("TimeOffEmployee")
  timeOffReviews         TimeOffRequest[]        @relation("TimeOffReviewer")
  organization           Organization?           @relation(fields: [organizationId], references: [id])
  roleAssignmentsGranted UserRole[]              @relation("RoleAssignedBy")
  roles                  UserRole[]
  notificationPreference NotificationPreference?
  pushSubscriptions      PushSubscription[]
  chatChannelsCreated    ChatChannel[]           @relation("ChatChannelCreatedBy")
  chatMembers            ChatMember[]
  chatMessages           ChatMessage[]
  chatTypingIndicators   ChatTypingIndicator[]
  chatReadReceipts       ChatReadReceipt[]
  googleCalendarConfigs  GoogleCalendarConfig[]
  supportTickets         SupportTicket[]       @relation("TicketCreatedBy")
  supportMessages        SupportMessage[]

  @@index([isActive])
  @@index([email])
  @@index([organizationId])
}

model Location {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  slug           String
  address        String?
  city           String?
  county         String?
  country        String         @default("RO")
  phone          String?
  email          String?
  timezone       String         @default("Europe/Bucharest")
  isActive       Boolean        @default(true)
  isPrimary      Boolean        @default(false)
  operatingHours Json?
  settings       Json?
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization           Organization           @relation(fields: [organizationId], references: [id])
  users                  UserLocation[]
  resources              Resource[]
  appointments           Appointment[]
  schedules              Schedule[]
  timeEntries            TimeEntry[]
  clients                Client[]
  tasks                  Task[]
  chatChannels           ChatChannel[]
  googleCalendarConfigs  GoogleCalendarConfig[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([isActive])
}

model UserLocation {
  id         String   @id @default(cuid())
  userId     String
  locationId String
  isPrimary  Boolean  @default(false)
  assignedAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
  @@index([userId])
  @@index([locationId])
}

model Role {
  id          String           @id @default(cuid())
  name        String
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model UserRole {
  id             String   @id @default(cuid())
  userId         String
  roleId         String
  assignedBy     String?
  assignedAt     DateTime @default(now())
  assignedByUser User?    @relation("RoleAssignedBy", fields: [assignedBy], references: [id])
  role           Role     @relation(fields: [roleId], references: [id])
  user           User     @relation(fields: [userId], references: [id])

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  context   String?   // 'admin' or 'crm' — token type for session isolation
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RegistrationRequest {
  id             String                    @id @default(cuid())
  firstName      String
  lastName       String
  email          String
  password       String
  phoneNumber    String
  dateOfBirth    DateTime
  requestedRole  String
  status         RegistrationRequestStatus @default(PENDING)
  reviewNotes    String?
  reviewerId     String?
  reviewedAt     DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  organizationId String?
  organization   Organization?             @relation(fields: [organizationId], references: [id])
  reviewer       User?                     @relation("RegistrationReviewer", fields: [reviewerId], references: [id])

  @@index([email])
  @@index([status])
}

model Client {
  id                 String               @id @default(cuid())
  firstName          String?
  lastName           String?
  phone              String?
  email              String?
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  companyName        String?
  contactName        String?
  registrationNumber String?
  type               ClientType           @default(PF)
  vatNumber          String?
  address            String?
  isOnline           Boolean              @default(false)
  fidelityCardSerie  String?
  organizationId     String?
  locationId         String?
  appointments       Appointment[]
  assets             Asset[]
  organization       Organization?        @relation(fields: [organizationId], references: [id])
  locationRef        Location?            @relation(fields: [locationId], references: [id])
  invoices           Invoice[]
  account            ClientAccount?
  messages           Message[]
  messageReadReceipts MessageReadReceipt[]
  notifications      ClientNotification[]
  loyaltyAccount     LoyaltyAccount?

  @@unique([organizationId, email], name: "client_org_email_unique")
  @@index([organizationId])
  @@index([lastName, firstName])
  @@index([phone])
  @@index([email])
  @@index([isOnline])
  @@index([fidelityCardSerie])
  @@index([locationId])
}


model Asset {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  identifier     String?
  type           String?
  manufacturer   String?
  model          String?
  year           Int?
  metadata       Json?
  clientId       String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  appointments   Appointment[]
  client         Client        @relation(fields: [clientId], references: [id])
  organization   Organization  @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([clientId])
  @@index([identifier])
}

model Resource {
  id             String        @id @default(cuid())
  organizationId String
  locationId     String?
  name           String
  type           String
  description    String?
  capacity       Int           @default(1)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  appointments   Appointment[]
  organization   Organization  @relation(fields: [organizationId], references: [id])
  location       Location?     @relation(fields: [locationId], references: [id])

  @@index([organizationId])
  @@index([locationId])
  @@index([isActive])
}

model Appointment {
  id                 String                @id @default(cuid())
  title              String
  description        String?
  status             AppointmentStatus     @default(PENDING)
  scheduledStart     DateTime
  scheduledEnd       DateTime
  location           String?
  clientId           String?
  createdById        String
  updatedById        String?
  cancellationReason String?
  metadata           Json?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  advancePaidAt      DateTime?
  advancePayment     Decimal?              @default(0) @db.Decimal(10, 2)
  finalPaidAt        DateTime?
  paymentStatus      PaymentStatus         @default(UNPAID)
  remainingBalance   Decimal?              @db.Decimal(10, 2)
  assetId            String?
  organizationId     String?
  resourceId         String?
  locationId         String?
  asset              Asset?                @relation(fields: [assetId], references: [id])
  client             Client?               @relation(fields: [clientId], references: [id])
  createdBy          User                  @relation("AppointmentCreatedBy", fields: [createdById], references: [id])
  organization       Organization?         @relation(fields: [organizationId], references: [id])
  resource           Resource?             @relation(fields: [resourceId], references: [id])
  locationRef        Location?             @relation(fields: [locationId], references: [id])
  updatedBy          User?                 @relation("AppointmentUpdatedBy", fields: [updatedById], references: [id])
  assignees          AppointmentAssignee[]
  invoices           Invoice[]
  messages           Message[]
  payments           Payment[]
  serviceOrder       ServiceOrder?

  @@index([clientId])
  @@index([assetId])
  @@index([resourceId])
  @@index([locationId])
  @@index([status, scheduledStart])
  @@index([createdById])
  @@index([scheduledStart, scheduledEnd])
  @@index([paymentStatus])
  // Compound index for dashboard queries that filter by org and date range
  @@index([organizationId, scheduledStart])
}

model AppointmentAssignee {
  id            String      @id @default(cuid())
  appointmentId String
  userId        String
  assignedAt    DateTime    @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id])

  @@unique([appointmentId, userId])
  @@index([userId])
  @@index([appointmentId])
}

model Payment {
  id             String        @id @default(cuid())
  appointmentId  String
  invoiceId      String?
  amount         Decimal       @db.Decimal(10, 2)
  paymentMethod  PaymentMethod @default(CASH)
  paymentDate    DateTime      @default(now())
  reference      String?
  notes          String?
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  type           PaymentType   @default(REGULAR)
  organizationId String?
  appointment    Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  createdBy      User          @relation(fields: [createdById], references: [id])
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([appointmentId])
  @@index([invoiceId])
  @@index([paymentDate])
  @@index([createdById])
}

model Message {
  id             String               @id @default(cuid())
  appointmentId  String
  authorId       String?              // CRM user author (nullable for client messages)
  clientAuthorId String?              // Client portal author (nullable for CRM messages)
  body           String
  type           MessageType          @default(TEXT)
  metadata       Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  appointment    Appointment          @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  author         User?                @relation(fields: [authorId], references: [id])
  clientAuthor   Client?              @relation(fields: [clientAuthorId], references: [id])
  attachments    MessageAttachment[]
  readReceipts   MessageReadReceipt[]

  @@index([appointmentId])
  @@index([clientAuthorId])
}

model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  fileName  String
  fileUrl   String
  fileType  String?
  fileSize  Int?
  metadata  Json?
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id])
}

model MessageReadReceipt {
  id        String   @id @default(cuid())
  messageId String
  userId    String?  // CRM user who read (nullable for client reads)
  clientId  String?  // Client who read (nullable for CRM user reads)
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])
  client    Client?  @relation(fields: [clientId], references: [id])

  @@unique([messageId, userId])
  @@unique([messageId, clientId])
  @@index([clientId])
}

model ChatChannel {
  id              String            @id @default(cuid())
  organizationId  String
  locationId      String?           // For LOCATION type channels
  name            String?
  description     String?
  type            ChatChannelType   @default(PUBLIC)
  createdById     String
  isArchived      Boolean           @default(false)
  archivedAt      DateTime?
  metadata        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organization    Organization      @relation(fields: [organizationId], references: [id])
  location        Location?         @relation(fields: [locationId], references: [id])
  createdBy       User              @relation("ChatChannelCreatedBy", fields: [createdById], references: [id])
  members         ChatMember[]
  messages        ChatMessage[]
  typingIndicators ChatTypingIndicator[]

  @@index([organizationId])
  @@index([locationId])
  @@index([type])
  @@index([isArchived])
}

model ChatMember {
  id              String           @id @default(cuid())
  channelId       String
  userId          String
  role            ChatMemberRole   @default(MEMBER)
  joinedAt        DateTime         @default(now())
  lastReadAt      DateTime?
  isMuted         Boolean          @default(false)
  isOnline        Boolean          @default(false)
  lastSeenAt      DateTime?
  channel         ChatChannel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id])

  @@unique([channelId, userId])
  @@index([userId])
  @@index([channelId])
}

model ChatMessage {
  id              String              @id @default(cuid())
  channelId       String
  authorId        String
  body            String
  type            ChatMessageType     @default(TEXT)
  metadata        Json?
  isDeleted       Boolean             @default(false)
  deletedAt       DateTime?
  editedAt        DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  channel         ChatChannel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author          User                @relation(fields: [authorId], references: [id])
  attachments     ChatAttachment[]
  readReceipts    ChatReadReceipt[]

  @@index([channelId, createdAt])
  @@index([channelId, isDeleted, createdAt])
  @@index([authorId])
}

model ChatAttachment {
  id              String           @id @default(cuid())
  messageId       String
  fileName        String
  fileUrl         String
  fileType        String?
  fileSize        Int?
  duration        Int?
  metadata        Json?
  createdAt       DateTime         @default(now())
  message         ChatMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model ChatReadReceipt {
  id              String           @id @default(cuid())
  messageId       String
  userId          String
  readAt          DateTime         @default(now())
  message         ChatMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
  @@index([userId])
}

model ChatTypingIndicator {
  id              String           @id @default(cuid())
  channelId       String
  userId          String
  startedAt       DateTime         @default(now())
  channel         ChatChannel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([startedAt])
}

model ServiceOrder {
  id             String                 @id @default(cuid())
  appointmentId  String                 @unique
  orderNumber    String
  status         ServiceOrderStatus     @default(DRAFT)
  pdfUrl         String?
  subtotal       Decimal?               @db.Decimal(12, 2)
  tax            Decimal?               @db.Decimal(12, 2)
  total          Decimal?               @db.Decimal(12, 2)
  notes          String?
  metadata       Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  organizationId String?
  invoices       Invoice[]
  appointment    Appointment            @relation(fields: [appointmentId], references: [id])
  organization   Organization?          @relation(fields: [organizationId], references: [id])
  lineItems      ServiceOrderLineItem[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId])
}

model ServiceOrderLineItem {
  id               String       @id @default(cuid())
  serviceOrderId   String
  name             String
  description      String?
  quantity         Int          @default(1)
  totalPrice       Decimal      @db.Decimal(12, 2)
  hardwarePrice    Decimal      @default(0) @db.Decimal(12, 2)
  laborPrice       Decimal      @default(0) @db.Decimal(12, 2)
  hardwareUnit     String?
  laborUnit        String?
  hardwareQuantity Int          @default(1)
  laborQuantity    Int          @default(1)
  serviceOrder     ServiceOrder @relation(fields: [serviceOrderId], references: [id])
}

model Invoice {
  id               String            @id @default(cuid())
  invoiceNumber    String
  appointmentId    String
  serviceOrderId   String?
  clientId         String
  status           InvoiceStatus     @default(DRAFT)
  issueDate        DateTime          @default(now())
  dueDate          DateTime
  subtotal         Decimal           @db.Decimal(12, 2)
  tax              Decimal           @db.Decimal(12, 2)
  total            Decimal           @db.Decimal(12, 2)
  notes            String?
  pdfUrl           String?
  sentAt           DateTime?
  paidAt           DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  advancePaidAt    DateTime?
  advancePayment   Decimal?          @default(0) @db.Decimal(10, 2)
  finalPaidAt      DateTime?
  paymentStatus    PaymentStatus     @default(UNPAID)
  remainingBalance Decimal?          @db.Decimal(10, 2)
  loyaltyDiscount    Decimal?          @db.Decimal(12, 2)
  loyaltyTierAtTime  String?
  organizationId   String
  appointment      Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  client           Client            @relation(fields: [clientId], references: [id])
  organization     Organization      @relation(fields: [organizationId], references: [id])
  serviceOrder     ServiceOrder?     @relation(fields: [serviceOrderId], references: [id])
  lineItems        InvoiceLineItem[]
  payments         Payment[]

  @@unique([organizationId, invoiceNumber])
  @@index([appointmentId])
  @@index([clientId])
  @@index([invoiceNumber])
  @@index([status])
  @@index([issueDate])
  @@index([dueDate])
  @@index([createdAt])
  @@index([paymentStatus])
  @@index([organizationId])
  // Compound indexes for common filter combinations under concurrent load
  @@index([organizationId, status, createdAt])
  @@index([organizationId, paymentStatus])
  @@index([organizationId, dueDate, status])
  @@index([organizationId, clientId])
  @@index([organizationId, issueDate])
}

model InvoiceLineItem {
  id               String  @id @default(cuid())
  invoiceId        String
  name             String
  description      String?
  quantity         Decimal @default(1) @db.Decimal(10, 3)
  totalPrice       Decimal @db.Decimal(12, 2)
  order            Int     @default(0)
  hardwarePrice    Decimal @default(0) @db.Decimal(12, 2)
  laborPrice       Decimal @default(0) @db.Decimal(12, 2)
  hardwareQuantity Int     @default(1)
  hardwareUnit     String?
  laborQuantity    Int     @default(1)
  laborUnit        String?
  invoice          Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([order])
}

model OrganizationProfile {
  id                 String       @id @default(cuid())
  organizationId     String       @unique @map("organization_id")
  companyName        String?      @map("company_name")
  legalName          String?      @map("legal_name")
  address            String?
  email              String?
  phone              String?
  website            String?
  logoUrl            String?      @map("logo_url")
  vatNumber          String?      @map("vat_number")
  registrationNumber String?      @map("registration_number")
  bankName           String?      @map("bank_name")
  iban               String?
  swift              String?
  contactPerson      String?      @map("contact_person")
  footerNote         String?      @map("footer_note")
  gdprNote           String?      @map("gdpr_note")
  additionalNote     String?      @map("additional_note")
  rampCount          Int          @default(4) @map("ramp_count")
  tvaEnabled         Boolean      @default(false) @map("tva_enabled")
  tvaPercentage      Float        @default(19) @map("tva_percentage")
  entityType         String?      @map("entity_type")
  cnp                String?
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("OrganizationProfile")
}

model Schedule {
  id              String            @id @default(cuid())
  employeeId      String
  createdById     String
  updatedById     String?
  date            DateTime
  startTime       String
  endTime         String
  shiftType       ScheduleShiftType @default(REGULAR)
  status          ScheduleStatus    @default(SCHEDULED)
  location        String?           @default("physical-shop")
  actualStartTime String?
  actualEndTime   String?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organizationId  String?
  locationId      String?
  createdBy       User              @relation("ScheduleCreatedBy", fields: [createdById], references: [id])
  employee        User              @relation("ScheduleEmployee", fields: [employeeId], references: [id])
  organization    Organization?     @relation(fields: [organizationId], references: [id])
  locationRef     Location?         @relation(fields: [locationId], references: [id])
  updatedBy       User?             @relation("ScheduleUpdatedBy", fields: [updatedById], references: [id])
  timeEntries     TimeEntry[]

  @@index([organizationId])
  @@index([employeeId, date])
  @@index([date, status])
  @@index([locationId])
}

model Task {
  id                   String           @id @default(cuid())
  title                String
  description          String?
  taskType             TaskType         @default(INSTALLATION)
  priority             TaskPriority     @default(MEDIUM)
  status               TaskStatus       @default(TODO)
  dueDate              DateTime?
  estimatedHours       Float            @default(0)
  completionPercentage Int              @default(0)
  customerName         String?
  customerPhone        String?
  customerVehicle      String?
  createdById          String
  updatedById          String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  organizationId       String?
  locationId           String?
  createdBy            User             @relation("TaskCreatedBy", fields: [createdById], references: [id])
  organization         Organization?    @relation(fields: [organizationId], references: [id])
  locationRef          Location?        @relation(fields: [locationId], references: [id])
  updatedBy            User?            @relation("TaskUpdatedBy", fields: [updatedById], references: [id])
  assignments          TaskAssignment[]
  comments             TaskComment[]
  products             TaskProduct[]

  @@index([organizationId])
  @@index([status, priority])
  @@index([dueDate])
  @@index([createdById])
  @@index([status, dueDate])
  @@index([locationId])
}

model TaskAssignment {
  id     String @id @default(cuid())
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([taskId, userId])
  @@index([userId])
  @@index([taskId])
}

model TaskProduct {
  id          String  @id @default(cuid())
  taskId      String
  productName String
  sku         String?
  quantity    Int     @default(1)
  task        Task    @relation(fields: [taskId], references: [id])

  @@index([taskId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  text      String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
  task      Task     @relation(fields: [taskId], references: [id])

  @@index([taskId, createdAt])
}

model TimeEntry {
  id               String          @id @default(cuid())
  employeeId       String
  scheduleId       String?
  clockIn          DateTime
  clockOut         DateTime?
  breakDuration    Int             @default(0)
  totalMinutes     Int             @default(0)
  clockInLocation  String?
  clockOutLocation String?
  notes            String?
  source           TimeEntrySource @default(MANUAL)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  organizationId   String?
  locationId       String?
  employee         User            @relation(fields: [employeeId], references: [id])
  organization     Organization?   @relation(fields: [organizationId], references: [id])
  schedule         Schedule?       @relation(fields: [scheduleId], references: [id])
  locationRef      Location?       @relation(fields: [locationId], references: [id])

  @@index([organizationId])
  @@index([employeeId, clockIn])
  @@index([locationId])
}

model TimeOffRequest {
  id             String        @id @default(cuid())
  employeeId     String
  reviewerId     String?
  leaveType      LeaveType
  status         LeaveStatus   @default(PENDING)
  startDate      DateTime
  endDate        DateTime
  totalDays      Float
  reason         String
  reviewNotes    String?
  reviewedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  isMedical      Boolean       @default(false)
  organizationId String?
  employee       User          @relation("TimeOffEmployee", fields: [employeeId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
  reviewer       User?         @relation("TimeOffReviewer", fields: [reviewerId], references: [id])

  @@index([organizationId])
  @@index([employeeId, status])
  @@index([status, startDate])
  @@index([startDate, endDate])
  @@index([isMedical])
}

model Notification {
  id             String           @id @default(cuid())
  recipientId    String
  title          String
  message        String
  type           NotificationType @default(ANNOUNCEMENT)
  entityType     String?
  entityId       String?
  metadata       Json?
  isRead         Boolean          @default(false)
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id])
  recipient      User             @relation("NotificationRecipient", fields: [recipientId], references: [id])

  @@index([organizationId])
  @@index([recipientId, isRead])
}

model ClientNotification {
  id         String           @id @default(cuid())
  clientId   String
  title      String
  message    String
  type       NotificationType @default(ANNOUNCEMENT)
  entityType String?
  entityId   String?
  metadata   Json?
  isRead     Boolean          @default(false)
  readAt     DateTime?
  createdAt  DateTime         @default(now())
  client     Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, isRead])
  @@index([createdAt])
}

model AuditLog {
  id             String        @id @default(cuid())
  actorId        String?
  action         AuditAction
  entityType     String
  entityId       String?
  description    String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime      @default(now())
  organizationId String?
  actor          User?         @relation(fields: [actorId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  // Compound index for admin log views that filter by org and sort by date
  @@index([organizationId, createdAt])
}

model PersonalTodo {
  id          String               @id @default(cuid())
  userId      String
  title       String
  description String?
  isCompleted Boolean              @default(false)
  priority    PersonalTodoPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isCompleted])
  @@index([userId, dueDate])
  @@index([dueDate])
}





model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  keys      Json
  userAgent String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@map("push_subscriptions")
}

model NotificationPreference {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  enablePushNotifications Boolean  @default(true)
  enableAppointments      Boolean  @default(true)
  enableLeaveRequests     Boolean  @default(true)
  enableTasks             Boolean  @default(true)
  enableReminders         Boolean  @default(true)
  enableMessages          Boolean  @default(true)
  enablePayments          Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

