generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  status               OrganizationStatus    @default(TRIAL)
  plan                 SubscriptionPlan      @default(FREE)
  trialEndsAt          DateTime?
  trialStartedAt       DateTime              @default(now())
  subscriptionId       String?               @unique
  subscriptionEndsAt   DateTime?
  settings             Json?
  maxUsers             Int                   @default(5)
  maxClients           Int                   @default(100)
  maxAppointments      Int                   @default(500)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  appointments         Appointment[]
  assets               Asset[]
  auditLogs            AuditLog[]
  clients              Client[]
  invoices             Invoice[]
  notifications        Notification[]
  payments             Payment[]
  registrationRequests RegistrationRequest[]
  resources            Resource[]
  schedules            Schedule[]
  serviceOrders        ServiceOrder[]
  tasks                Task[]
  timeEntries          TimeEntry[]
  timeOffRequests      TimeOffRequest[]
  users                User[]
  vehicles             Vehicle[]
  chatChannels         ChatChannel[]
  emailLogs            EmailLog[]
  emailTemplates       EmailTemplate[]

  @@index([slug])
  @@index([status])
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  password               String
  firstName              String
  lastName               String
  phoneNumber            String?
  dateOfBirth            DateTime?
  employmentType         EmploymentType          @default(FULL_TIME)
  hourlyRate             Decimal?                @db.Decimal(10, 2)
  hireDate               DateTime?               @default(now())
  isActive               Boolean                 @default(true)
  avatarUrl              String?
  leaveBalanceVacation   Int                     @default(21)
  leaveBalanceSick       Int                     @default(15)
  leaveBalancePersonal   Int                     @default(5)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  organizationId         String?
  appointmentsCreated    Appointment[]           @relation("AppointmentCreatedBy")
  appointmentsUpdated    Appointment[]           @relation("AppointmentUpdatedBy")
  appointmentAssignees   AppointmentAssignee[]
  auditLogs              AuditLog[]
  messages               Message[]
  messageReadReceipts    MessageReadReceipt[]
  notifications          Notification[]          @relation("NotificationRecipient")
  paymentsCreated        Payment[]
  personalTodos          PersonalTodo[]
  refreshTokens          RefreshToken[]
  registrationReviews    RegistrationRequest[]   @relation("RegistrationReviewer")
  schedulesCreated       Schedule[]              @relation("ScheduleCreatedBy")
  schedules              Schedule[]              @relation("ScheduleEmployee")
  schedulesUpdated       Schedule[]              @relation("ScheduleUpdatedBy")
  tasksCreated           Task[]                  @relation("TaskCreatedBy")
  tasksUpdated           Task[]                  @relation("TaskUpdatedBy")
  taskAssignments        TaskAssignment[]
  taskComments           TaskComment[]
  timeEntries            TimeEntry[]
  timeOffRequests        TimeOffRequest[]        @relation("TimeOffEmployee")
  timeOffReviews         TimeOffRequest[]        @relation("TimeOffReviewer")
  organization           Organization?           @relation(fields: [organizationId], references: [id])
  roleAssignmentsGranted UserRole[]              @relation("RoleAssignedBy")
  roles                  UserRole[]
  notificationPreference NotificationPreference?
  pushSubscriptions      PushSubscription[]
  chatChannelsCreated    ChatChannel[]           @relation("ChatChannelCreatedBy")
  chatMembers            ChatMember[]
  chatMessages           ChatMessage[]
  chatReadReceipts       ChatReadReceipt[]
  googleCalendarConfig   GoogleCalendarConfig?

  @@index([isActive])
  @@index([email])
}

model Role {
  id          String           @id @default(cuid())
  name        String
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model UserRole {
  id             String   @id @default(cuid())
  userId         String
  roleId         String
  assignedBy     String?
  assignedAt     DateTime @default(now())
  assignedByUser User?    @relation("RoleAssignedBy", fields: [assignedBy], references: [id])
  role           Role     @relation(fields: [roleId], references: [id])
  user           User     @relation(fields: [userId], references: [id])

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model RegistrationRequest {
  id             String                    @id @default(cuid())
  firstName      String
  lastName       String
  email          String
  password       String
  phoneNumber    String
  dateOfBirth    DateTime
  requestedRole  String
  status         RegistrationRequestStatus @default(PENDING)
  reviewNotes    String?
  reviewerId     String?
  reviewedAt     DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  organizationId String?
  organization   Organization?             @relation(fields: [organizationId], references: [id])
  reviewer       User?                     @relation("RegistrationReviewer", fields: [reviewerId], references: [id])

  @@index([email])
  @@index([status])
}

model Client {
  id                 String        @id @default(cuid())
  firstName          String?
  lastName           String?
  phone              String?
  email              String?
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  companyName        String?
  contactName        String?
  registrationNumber String?
  type               ClientType    @default(PF)
  vatNumber          String?
  address            String?
  isOnline           Boolean       @default(false)
  fidelityCardSerie  String?
  organizationId     String?
  appointments       Appointment[]
  assets             Asset[]
  organization       Organization? @relation(fields: [organizationId], references: [id])
  invoices           Invoice[]
  vehicles           Vehicle[]
  account            ClientAccount?

  @@index([lastName, firstName])
  @@index([phone])
  @@index([email])
  @@index([isOnline])
  @@index([fidelityCardSerie])
}

model Vehicle {
  id             String        @id @default(cuid())
  clientId       String
  make           String?
  model          String?
  year           Int?
  vin            String?       @unique
  plateNumber    String?
  color          String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  carId          String?
  odometerKm     Int?
  organizationId String?
  assetType      String?
  metadata       Json?
  appointments   Appointment[]
  client         Client        @relation(fields: [clientId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([clientId])
  @@index([plateNumber])
  @@index([assetType])
}

model Asset {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  identifier     String?
  type           String?
  manufacturer   String?
  model          String?
  year           Int?
  metadata       Json?
  clientId       String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  appointments   Appointment[]
  client         Client        @relation(fields: [clientId], references: [id])
  organization   Organization  @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([clientId])
  @@index([identifier])
}

model Resource {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  type           String
  description    String?
  capacity       Int           @default(1)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  appointments   Appointment[]
  organization   Organization  @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([isActive])
}

model Appointment {
  id                 String                @id @default(cuid())
  title              String
  description        String?
  status             AppointmentStatus     @default(PENDING)
  scheduledStart     DateTime
  scheduledEnd       DateTime
  location           String?
  clientId           String?
  vehicleId          String?
  createdById        String
  updatedById        String?
  cancellationReason String?
  metadata           Json?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  advancePaidAt      DateTime?
  advancePayment     Decimal?              @default(0) @db.Decimal(10, 2)
  finalPaidAt        DateTime?
  paymentStatus      PaymentStatus         @default(UNPAID)
  remainingBalance   Decimal?              @db.Decimal(10, 2)
  assetId            String?
  organizationId     String?
  resourceId         String?
  asset              Asset?                @relation(fields: [assetId], references: [id])
  client             Client?               @relation(fields: [clientId], references: [id])
  createdBy          User                  @relation("AppointmentCreatedBy", fields: [createdById], references: [id])
  organization       Organization?         @relation(fields: [organizationId], references: [id])
  resource           Resource?             @relation(fields: [resourceId], references: [id])
  updatedBy          User?                 @relation("AppointmentUpdatedBy", fields: [updatedById], references: [id])
  vehicle            Vehicle?              @relation(fields: [vehicleId], references: [id])
  assignees          AppointmentAssignee[]
  invoices           Invoice[]
  messages           Message[]
  payments           Payment[]
  serviceOrder       ServiceOrder?

  @@index([clientId])
  @@index([vehicleId])
  @@index([assetId])
  @@index([resourceId])
  @@index([status, scheduledStart])
  @@index([createdById])
  @@index([scheduledStart, scheduledEnd])
  @@index([paymentStatus])
}

model AppointmentAssignee {
  id            String      @id @default(cuid())
  appointmentId String
  userId        String
  assignedAt    DateTime    @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@unique([appointmentId, userId])
  @@index([userId])
  @@index([appointmentId])
}

model Payment {
  id             String        @id @default(cuid())
  appointmentId  String
  invoiceId      String?
  amount         Decimal       @db.Decimal(10, 2)
  paymentMethod  PaymentMethod @default(CASH)
  paymentDate    DateTime      @default(now())
  reference      String?
  notes          String?
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  type           PaymentType   @default(REGULAR)
  organizationId String?
  appointment    Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  createdBy      User          @relation(fields: [createdById], references: [id])
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([appointmentId])
  @@index([invoiceId])
  @@index([paymentDate])
  @@index([createdById])
}

model Message {
  id            String               @id @default(cuid())
  appointmentId String
  authorId      String
  body          String
  type          MessageType          @default(TEXT)
  metadata      Json?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  appointment   Appointment          @relation(fields: [appointmentId], references: [id])
  author        User                 @relation(fields: [authorId], references: [id])
  attachments   MessageAttachment[]
  readReceipts  MessageReadReceipt[]

  @@index([appointmentId])
}

model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  fileName  String
  fileUrl   String
  fileType  String?
  fileSize  Int?
  metadata  Json?
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id])
}

model MessageReadReceipt {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
}

model ChatChannel {
  id              String            @id @default(cuid())
  organizationId  String
  name            String?
  description     String?
  type            ChatChannelType   @default(PUBLIC)
  createdById     String
  isArchived      Boolean           @default(false)
  archivedAt      DateTime?
  metadata        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organization    Organization      @relation(fields: [organizationId], references: [id])
  createdBy       User              @relation("ChatChannelCreatedBy", fields: [createdById], references: [id])
  members         ChatMember[]
  messages        ChatMessage[]

  @@index([organizationId])
  @@index([type])
  @@index([isArchived])
}

model ChatMember {
  id              String           @id @default(cuid())
  channelId       String
  userId          String
  role            ChatMemberRole   @default(MEMBER)
  joinedAt        DateTime         @default(now())
  lastReadAt      DateTime?
  isMuted         Boolean          @default(false)
  isOnline        Boolean          @default(false)
  lastSeenAt      DateTime?
  channel         ChatChannel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id])

  @@unique([channelId, userId])
  @@index([userId])
  @@index([channelId])
}

model ChatMessage {
  id              String              @id @default(cuid())
  channelId       String
  authorId        String
  body            String
  type            ChatMessageType     @default(TEXT)
  metadata        Json?
  isDeleted       Boolean             @default(false)
  deletedAt       DateTime?
  editedAt        DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  channel         ChatChannel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author          User                @relation(fields: [authorId], references: [id])
  attachments     ChatAttachment[]
  readReceipts    ChatReadReceipt[]

  @@index([channelId, createdAt])
  @@index([authorId])
}

model ChatAttachment {
  id              String           @id @default(cuid())
  messageId       String
  fileName        String
  fileUrl         String
  fileType        String?
  fileSize        Int?
  duration        Int?
  metadata        Json?
  createdAt       DateTime         @default(now())
  message         ChatMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model ChatReadReceipt {
  id              String           @id @default(cuid())
  messageId       String
  userId          String
  readAt          DateTime         @default(now())
  message         ChatMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
  @@index([userId])
}

model ChatTypingIndicator {
  id              String           @id @default(cuid())
  channelId       String
  userId          String
  startedAt       DateTime         @default(now())

  @@unique([channelId, userId])
  @@index([startedAt])
}

model ServiceOrder {
  id             String                 @id @default(cuid())
  appointmentId  String                 @unique
  orderNumber    String
  status         ServiceOrderStatus     @default(DRAFT)
  pdfUrl         String?
  subtotal       Decimal?               @db.Decimal(12, 2)
  tax            Decimal?               @db.Decimal(12, 2)
  total          Decimal?               @db.Decimal(12, 2)
  notes          String?
  metadata       Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  organizationId String?
  invoices       Invoice[]
  appointment    Appointment            @relation(fields: [appointmentId], references: [id])
  organization   Organization?          @relation(fields: [organizationId], references: [id])
  lineItems      ServiceOrderLineItem[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId])
}

model ServiceOrderLineItem {
  id               String       @id @default(cuid())
  serviceOrderId   String
  name             String
  description      String?
  quantity         Int          @default(1)
  totalPrice       Decimal      @db.Decimal(12, 2)
  hardwarePrice    Decimal      @default(0) @db.Decimal(12, 2)
  laborPrice       Decimal      @default(0) @db.Decimal(12, 2)
  hardwareUnit     String?
  laborUnit        String?
  hardwareQuantity Int          @default(1)
  laborQuantity    Int          @default(1)
  serviceOrder     ServiceOrder @relation(fields: [serviceOrderId], references: [id])
}

model Invoice {
  id               String            @id @default(cuid())
  invoiceNumber    String
  appointmentId    String
  serviceOrderId   String?
  clientId         String
  status           InvoiceStatus     @default(DRAFT)
  issueDate        DateTime          @default(now())
  dueDate          DateTime
  subtotal         Decimal           @db.Decimal(12, 2)
  tax              Decimal           @db.Decimal(12, 2)
  total            Decimal           @db.Decimal(12, 2)
  notes            String?
  pdfUrl           String?
  sentAt           DateTime?
  paidAt           DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  advancePaidAt    DateTime?
  advancePayment   Decimal?          @default(0) @db.Decimal(10, 2)
  finalPaidAt      DateTime?
  paymentStatus    PaymentStatus     @default(UNPAID)
  remainingBalance Decimal?          @db.Decimal(10, 2)
  organizationId   String
  anafSync         AnafInvoiceSync?
  appointment      Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  client           Client            @relation(fields: [clientId], references: [id])
  organization     Organization      @relation(fields: [organizationId], references: [id])
  serviceOrder     ServiceOrder?     @relation(fields: [serviceOrderId], references: [id])
  lineItems        InvoiceLineItem[]
  payments         Payment[]

  @@unique([organizationId, invoiceNumber])
  @@index([appointmentId])
  @@index([clientId])
  @@index([invoiceNumber])
  @@index([status])
  @@index([issueDate])
  @@index([dueDate])
  @@index([createdAt])
  @@index([paymentStatus])
  @@index([organizationId])
}

model InvoiceLineItem {
  id               String  @id @default(cuid())
  invoiceId        String
  name             String
  description      String?
  quantity         Decimal @default(1) @db.Decimal(10, 3)
  totalPrice       Decimal @db.Decimal(12, 2)
  order            Int     @default(0)
  hardwarePrice    Decimal @default(0) @db.Decimal(12, 2)
  laborPrice       Decimal @default(0) @db.Decimal(12, 2)
  hardwareQuantity Int     @default(1)
  hardwareUnit     String?
  laborQuantity    Int     @default(1)
  laborUnit        String?
  invoice          Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([order])
}

model CompanySetting {
  id        String   @id @default(cuid())
  name      String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Schedule {
  id              String            @id @default(cuid())
  employeeId      String
  createdById     String
  updatedById     String?
  date            DateTime
  startTime       String
  endTime         String
  shiftType       ScheduleShiftType @default(REGULAR)
  status          ScheduleStatus    @default(SCHEDULED)
  location        String?           @default("physical-shop")
  actualStartTime String?
  actualEndTime   String?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organizationId  String?
  createdBy       User              @relation("ScheduleCreatedBy", fields: [createdById], references: [id])
  employee        User              @relation("ScheduleEmployee", fields: [employeeId], references: [id])
  organization    Organization?     @relation(fields: [organizationId], references: [id])
  updatedBy       User?             @relation("ScheduleUpdatedBy", fields: [updatedById], references: [id])
  timeEntries     TimeEntry[]

  @@index([employeeId, date])
  @@index([date, status])
}

model Task {
  id                   String           @id @default(cuid())
  title                String
  description          String?
  taskType             TaskType         @default(INSTALLATION)
  priority             TaskPriority     @default(MEDIUM)
  status               TaskStatus       @default(TODO)
  dueDate              DateTime?
  estimatedHours       Float            @default(0)
  completionPercentage Int              @default(0)
  customerName         String?
  customerPhone        String?
  customerVehicle      String?
  createdById          String
  updatedById          String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  organizationId       String?
  createdBy            User             @relation("TaskCreatedBy", fields: [createdById], references: [id])
  organization         Organization?    @relation(fields: [organizationId], references: [id])
  updatedBy            User?            @relation("TaskUpdatedBy", fields: [updatedById], references: [id])
  assignments          TaskAssignment[]
  comments             TaskComment[]
  products             TaskProduct[]

  @@index([status, priority])
  @@index([dueDate])
  @@index([createdById])
  @@index([status, dueDate])
}

model TaskAssignment {
  id     String @id @default(cuid())
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([taskId, userId])
  @@index([userId])
  @@index([taskId])
}

model TaskProduct {
  id          String  @id @default(cuid())
  taskId      String
  productName String
  sku         String?
  quantity    Int     @default(1)
  task        Task    @relation(fields: [taskId], references: [id])

  @@index([taskId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  text      String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
  task      Task     @relation(fields: [taskId], references: [id])

  @@index([taskId, createdAt])
}

model TimeEntry {
  id               String          @id @default(cuid())
  employeeId       String
  scheduleId       String?
  clockIn          DateTime
  clockOut         DateTime?
  breakDuration    Int             @default(0)
  totalMinutes     Int             @default(0)
  clockInLocation  String?
  clockOutLocation String?
  notes            String?
  source           TimeEntrySource @default(MANUAL)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  organizationId   String?
  employee         User            @relation(fields: [employeeId], references: [id])
  organization     Organization?   @relation(fields: [organizationId], references: [id])
  schedule         Schedule?       @relation(fields: [scheduleId], references: [id])

  @@index([employeeId, clockIn])
}

model TimeOffRequest {
  id             String        @id @default(cuid())
  employeeId     String
  reviewerId     String?
  leaveType      LeaveType
  status         LeaveStatus   @default(PENDING)
  startDate      DateTime
  endDate        DateTime
  totalDays      Float
  reason         String
  reviewNotes    String?
  reviewedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  isMedical      Boolean       @default(false)
  organizationId String?
  employee       User          @relation("TimeOffEmployee", fields: [employeeId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
  reviewer       User?         @relation("TimeOffReviewer", fields: [reviewerId], references: [id])

  @@index([employeeId, status])
  @@index([status, startDate])
  @@index([startDate, endDate])
  @@index([isMedical])
}

model Notification {
  id             String           @id @default(cuid())
  recipientId    String
  title          String
  message        String
  type           NotificationType @default(ANNOUNCEMENT)
  entityType     String?
  entityId       String?
  metadata       Json?
  isRead         Boolean          @default(false)
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id])
  recipient      User             @relation("NotificationRecipient", fields: [recipientId], references: [id])

  @@index([recipientId, isRead])
}

model AuditLog {
  id             String        @id @default(cuid())
  actorId        String?
  action         AuditAction
  entityType     String
  entityId       String?
  description    String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime      @default(now())
  organizationId String?
  actor          User?         @relation(fields: [actorId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

model PersonalTodo {
  id          String               @id @default(cuid())
  userId      String
  title       String
  description String?
  isCompleted Boolean              @default(false)
  priority    PersonalTodoPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isCompleted])
  @@index([userId, dueDate])
  @@index([dueDate])
}

model Company {
  id                 String      @id @default(cuid())
  name               String
  vatNumber          String      @unique
  registrationNumber String?
  address            String?
  city               String?
  county             String?
  country            String      @default("RO")
  phone              String?
  email              String?
  bankAccount        String?
  bankName           String?
  isActive           Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  anafConfig         AnafConfig?
}

model AnafConfig {
  id           String      @id @default(cuid())
  companyId    String      @unique
  clientId     String
  clientSecret String
  redirectUri  String
  cif          String
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  demoMode     Boolean     @default(false)
  environment  String      @default("test")
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tokens       AnafToken[]

  @@index([cif])
  @@index([environment])
}

model AnafToken {
  id               String     @id @default(cuid())
  configId         String
  accessToken      String
  refreshToken     String
  expiresAt        DateTime
  refreshExpiresAt DateTime
  tokenType        String     @default("Bearer")
  scope            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  isDemoData       Boolean    @default(false)
  config           AnafConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@index([expiresAt])
  @@index([isDemoData])
}

model AnafInvoiceSync {
  id            String            @id @default(cuid())
  invoiceId     String            @unique
  uploadIndex   String?
  downloadId    String?
  status        AnafInvoiceStatus @default(PENDING)
  anafStatus    String?
  errorMessage  String?
  uploadedAt    DateTime?
  processedAt   DateTime?
  lastCheckedAt DateTime?
  retryCount    Int               @default(0)
  maxRetries    Int               @default(3)
  xmlContent    String?
  responseData  Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  isDemoData    Boolean           @default(false)
  invoice       Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([status])
  @@index([uploadIndex])
  @@index([createdAt])
  @@index([isDemoData])
}

model AnafMessage {
  id            String    @id @default(cuid())
  anafMessageId String    @unique
  cif           String
  solicitareId  String?
  tip           String
  dataCreare    String
  downloadId    String?
  downloaded    Boolean   @default(false)
  downloadedAt  DateTime?
  content       String?
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isDemoData    Boolean   @default(false)

  @@index([cif])
  @@index([tip])
  @@index([downloaded])
  @@index([dataCreare])
  @@index([isDemoData])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  keys      Json
  userAgent String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@map("push_subscriptions")
}

model NotificationPreference {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  enablePushNotifications Boolean  @default(true)
  enableAppointments      Boolean  @default(true)
  enableLeaveRequests     Boolean  @default(true)
  enableTasks             Boolean  @default(true)
  enableReminders         Boolean  @default(true)
  enableMessages          Boolean  @default(true)
  enablePayments          Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

